# Stage 1: Build daemon binary inside Linux
FROM oven/bun:1 AS builder

WORKDIR /build

# Copy only what's needed for daemon build
COPY tsconfig.base.json ./
COPY daemon/package.json daemon/tsconfig.json daemon/
COPY daemon/src/ daemon/src/

# Install daemon deps only
RUN cd daemon && bun install

# Build daemon binary
RUN cd daemon && bun build src/index.ts --compile --outfile dist/haqi-daemon

# Stage 3: Install CLI deps
FROM oven/bun:1 AS cli-builder

WORKDIR /opt/haqi

# Copy workspace structure but only cli + shared + hub
COPY tsconfig.base.json ./
COPY shared/package.json shared/tsconfig.json shared/
COPY shared/src/ shared/src/
COPY cli/package.json cli/tsconfig.json cli/
COPY cli/src/ cli/src/
COPY cli/bin/ cli/bin/
COPY hub/package.json hub/tsconfig.json hub/
COPY hub/src/ hub/src/

# Copy daemon types (cli depends on @hapi/daemon/types)
COPY daemon/package.json daemon/tsconfig.json daemon/
COPY daemon/src/types.ts daemon/src/types.ts

# Create a minimal root package.json with just needed workspaces
RUN echo '{"private":true,"workspaces":["cli","shared","hub","daemon"]}' > package.json
RUN bun install

# Stage 3: Runtime image
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    bash-completion ca-certificates curl git gnupg iproute2 jq less lsof nano procps rsync sudo unzip vim zsh \
    dnsutils iputils-ping net-tools \
    build-essential make pkg-config python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo \"$VERSION_CODENAME\") stable" \
    > /etc/apt/sources.list.d/docker.list

RUN apt-get update && apt-get install -y \
    containerd.io docker-buildx-plugin docker-ce docker-ce-cli docker-ce-rootless-extras docker-compose-plugin \
    uidmap fuse-overlayfs \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /usr/share/keyrings/google-chrome-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/google-chrome-keyring.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list

# Desktop environment for Computer Use (fontconfig = fc-cache; gtk-update-icon-cache for icon theme)
RUN apt-get update && apt-get install -y \
    xvfb xfce4 xfce4-terminal dbus-x11 \
    plank \
    tigervnc-standalone-server tigervnc-common \
    novnc websockify \
    google-chrome-stable \
    xdotool scrot imagemagick \
    ffmpeg \
    fonts-liberation fonts-noto-color-emoji \
    fontconfig gtk-update-icon-cache \
    && update-alternatives --set x-www-browser /usr/bin/google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

RUN existing_group="$(getent group 1000 | cut -d: -f1 || true)" \
    && if getent group haqi >/dev/null; then true; \
        elif [ -n "$existing_group" ]; then groupmod -n haqi "$existing_group"; \
        else groupadd --gid 1000 haqi; \
        fi \
    && existing_user="$(getent passwd 1000 | cut -d: -f1 || true)" \
    && if id -u haqi >/dev/null 2>&1; then true; \
        elif [ -n "$existing_user" ]; then usermod -l haqi "$existing_user" \
            && usermod --home /home/haqi --move-home --gid haqi --shell /bin/bash haqi; \
        else useradd --uid 1000 --gid haqi --create-home --shell /bin/bash haqi; \
        fi \
    && usermod -aG sudo,docker haqi \
    && printf 'haqi ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/haqi \
    && chmod 0440 /etc/sudoers.d/haqi \
    && grep -q '^haqi:' /etc/subuid || echo 'haqi:100000:65536' >> /etc/subuid \
    && grep -q '^haqi:' /etc/subgid || echo 'haqi:100000:65536' >> /etc/subgid \
    && mkdir -p /workspace /home/haqi/.config /home/haqi/.config/docker /home/haqi/.local/bin /home/haqi/.local/share/docker /home/haqi/.local/state/haqi /home/haqi/.cache \
    && chown -R haqi:haqi /workspace /home/haqi

ENV DISPLAY=:1
ENV HAQI_CONTAINER_USER=haqi
ENV HAQI_CONTAINER_HOME=/home/haqi

# Cursor-matching XFCE / WhiteSur bundle (requires haqi user, desktop packages, fontconfig, gtk-update-icon-cache)
COPY docker/workspace-desktop /opt/haqi-workspace-desktop
RUN chmod +x /opt/haqi-workspace-desktop/install.sh \
    && HAQI_CONTAINER_HOME=/home/haqi /opt/haqi-workspace-desktop/install.sh

# GitHub CLI
RUN (curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg) \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Install Bun system-wide so non-root agent users can execute it.
ENV BUN_INSTALL=/usr/local/bun
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -sf /usr/local/bun/bin/bun /usr/local/bin/bun
ENV PATH="/usr/local/bun/bin:$PATH"

# Install Node.js (needed for Claude Code CLI)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install agent CLIs globally via npm. Both Claude and Codex are baked into
# the base image so checkpoint sessions work for either flavor without an
# additional setup step. `|| echo` prevents an npm registry blip from breaking
# the whole image build — the missing binary surfaces at run time as a clear
# "agent X not installed" error from the runner.
RUN npm install -g @anthropic-ai/claude-code || echo "claude install skipped"
RUN npm install -g @openai/codex || echo "codex install skipped"

# Copy daemon binary
COPY --from=builder /build/daemon/dist/haqi-daemon /usr/local/bin/haqi-daemon
RUN chmod +x /usr/local/bin/haqi-daemon

COPY daemon/bin/haqi-start-desktop-session /usr/local/bin/haqi-start-desktop-session
RUN chmod +x /usr/local/bin/haqi-start-desktop-session

COPY daemon/bin/haqi-start-inner-docker /usr/local/bin/haqi-start-inner-docker
RUN chmod +x /usr/local/bin/haqi-start-inner-docker

COPY daemon/bin/haqi-start-daemon-session /usr/local/bin/haqi-start-daemon-session
RUN chmod +x /usr/local/bin/haqi-start-daemon-session

COPY daemon/bin/haqi-docker /usr/local/bin/docker
RUN chmod +x /usr/local/bin/docker

# Copy CLI with deps
COPY --from=cli-builder /opt/haqi/ /opt/haqi/

# Create haqi wrapper
RUN printf '#!/bin/sh\ncd /opt/haqi/cli && exec bun src/index.ts "$@"\n' > /usr/local/bin/haqi && \
    chmod +x /usr/local/bin/haqi

WORKDIR /workspace
ENTRYPOINT ["haqi-daemon"]
