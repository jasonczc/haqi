{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM"],
        "noEmit": true,
        "types": ["node", "electron"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "*.ts"
    ],
    "exclude": ["node_modules", "out", ".vite"]
}
